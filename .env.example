EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-key
# Web client ID — this is the one that matters for auth (ID token audience + Supabase provider Client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id
# iOS client ID — also set as iosUrlScheme in app.json's google-signin plugin config
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id
# Android has no client ID env var — it's registered in Google Cloud Console via package name + SHA-1 only
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_AD_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_AD_UNIT_ID=